# --- API ---
WEBHOOK_SECRET=замените_на_длинную_случайную_строку
ADMIN_PASSWORD=замените_на_пароль_админа
PUBLIC_BASE_URL=https://school.example.com
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_PER_MINUTE=120

# --- Database ---
DATABASE_URL=postgresql+psycopg://literary:literary@localhost:5432/literary_school

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Gamification / LLM ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
GAMIFICATION_TEMPERATURE=0.4
RAG_TOP_K=6
USE_LLM=1

# --- Telegram (опционально) ---
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YourSchoolBot
TELEGRAM_WEBHOOK_SECRET=ещё_одна_случайная_строка

# --- Email SMTP (опционально, альтернатива Telegram) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=school@example.com
SMTP_USE_TLS=1

# Канал по умолчанию при регистрации: email | telegram | both | web
DEFAULT_NOTIFICATION_CHANNEL=email

# --- Auth (OTP + JWT для приложения) ---
JWT_SECRET=
JWT_TTL_SECONDS=2592000
OTP_TTL_SECONDS=600
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=8

# --- Плеер урока ---
LESSON_SIGNING_SECRET=
LESSON_LINK_TTL_SECONDS=7776000
VIDEO_BADGE_THRESHOLD=0.7
VIDEO_UNLOCK_SECONDS=180
# Устаревший алиас — равен VIDEO_BADGE_THRESHOLD
VIDEO_WATCH_THRESHOLD=0.7
# Приватная тест-страница: https://ВАШ_ДОМЕН/test/urok/ЭТОТ_СЕКРЕТ
TEST_LESSON_SECRET=
LESSON_WEEK_DAYS=7
# Понедельник старта модуля для всех семей (YYYY-MM-DD)
MODULE_START_DATE=2026-07-06

# --- Yandex Object Storage (видео, альтернатива Kinescope) ---
YANDEX_ACCESS_KEY=
YANDEX_SECRET_KEY=
YANDEX_BUCKET=
YANDEX_ENDPOINT=https://storage.yandexcloud.net
YANDEX_PUBLIC_BASE=
YANDEX_PRESIGN_TTL=14400
