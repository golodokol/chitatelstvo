# Скопируйте на сервер: cp deploy/env.production.example .env
# Замените ЗАМЕНИТЕ_* на свои значения

# --- API ---
WEBHOOK_SECRET=ЗАМЕНИТЕ_длинная_случайная_строка_32символа
PUBLIC_BASE_URL=https://api.chitatelstvo.ru
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_PER_MINUTE=120

# --- Database (хост postgres = имя сервиса в docker-compose) ---
DATABASE_URL=postgresql+psycopg://literary:ЗАМЕНИТЕ_ПАРОЛЬ_POSTGRES@postgres:5432/literary_school

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Gamification (на старте можно без LLM) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
USE_LLM=0

# --- Telegram (опционально) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=ЗАМЕНИТЕ_ещё_одна_случайная_строка

# --- Email (опционально) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@chitatelstvo.ru
SMTP_USE_TLS=1

DEFAULT_NOTIFICATION_CHANNEL=web

# --- Плеер урока ---
LESSON_SIGNING_SECRET=
LESSON_LINK_TTL_SECONDS=7776000
VIDEO_WATCH_THRESHOLD=0.8

# --- Yandex Object Storage (если не Kinescope) ---
YANDEX_ACCESS_KEY=
YANDEX_SECRET_KEY=
YANDEX_BUCKET=
YANDEX_ENDPOINT=https://storage.yandexcloud.net
