{
  "expo": {
    "name": "Читательство",
    "slug": "chitatelstvo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chitatelstvo",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F4F9",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.chitatelstvo.app"
    },
    "android": {
      "package": "ru.chitatelstvo.app",
      "backgroundColor": "#F6F4F9"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiBaseUrl": "https://api.chitatelstvo.ru"
    }
  }
}
